{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pet",
  "local": true,
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://localhost:*/*"
    ]
  },
  "windows": [
    "pet"
  ],
  "webviews": [
    "pet"
  ],
  "permissions": [
    "allow-pet-commands",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
